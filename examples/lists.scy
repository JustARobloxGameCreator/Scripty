// Lists: write items between [ ] separated by commas
let a = [0, 1, 3]
show max(a) // output: 3
show min(a)
show len(a)

// x = value (no let) gives an existing variable a new value
a = [0, 4, 2, 6, 3]

// sort(a) sorts the list itself, so show a afterwards
sort(a)
show a

// lists of text, joining lists, and going through the items
let names = ["Zed", "Ana", "Bo"]
sort(names)
show names
show names + ["Eve"]
for name in names:
    echo(name)

// lists work with functions too
function Biggest(items):
    give max(items)

show Biggest([5, 9, 2])

// reassigning a number
let total = 0
for n in a:
    total = total + n
show total
